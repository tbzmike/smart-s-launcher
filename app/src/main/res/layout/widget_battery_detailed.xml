<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/battery_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@+id/battery_widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/battery_widget_material_you" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/battery_widget_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--%" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="32sp" />
            <TextView android:id="@+id/battery_widget_state" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Battery" android:textColor="#FFE8EAED" android:textStyle="bold" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/battery_widget_line1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Now: -- mA" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:id="@+id/battery_widget_line2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Avg: learning…" android:textColor="#FFFFFFFF" android:textSize="14sp" />
        <TextView android:id="@+id/battery_widget_line3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Screen on: learning…" android:textColor="#FFE8EAED" android:textSize="14sp" />
        <TextView android:id="@+id/battery_widget_line4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Screen off: learning…" android:textColor="#FFE8EAED" android:textSize="14sp" />
        <TextView android:id="@+id/battery_widget_line5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="-- W · --°C · -- mV" android:textColor="#FFDADCE0" android:textSize="12sp" />
        <TextView android:id="@+id/battery_widget_line6" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Capacity / health learning…" android:textColor="#FFBDC1C6" android:textSize="11sp" android:maxLines="2" />
    </LinearLayout>

    <TextView android:id="@+id/battery_widget_style" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="9dp" android:layout_marginEnd="13dp" android:padding="5dp" android:text="STYLE" android:textColor="#CCFFFFFF" android:textStyle="bold" android:textSize="9sp" />
</FrameLayout>
