<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ResultItem"
    tools:layout_height="@dimen/result_height"
    android:orientation="horizontal">

    <FrameLayout
        style="@style/ResultItemIcon"
        android:layout_gravity="start|center_vertical"
        tools:layout_height="@dimen/result_icon_size"
        tools:layout_width="@dimen/result_icon_size">

        <ImageView
            android:id="@+id/item_shortcut_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_launcher_white" />

        <ImageView
            android:id="@+id/item_app_icon"
            android:layout_width="?attr/resultSubIconSize"
            android:layout_height="?attr/resultSubIconSize"
            android:layout_gravity="end|bottom"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tools:layout_height="@dimen/result_subicon_size"
            tools:layout_width="@dimen/result_subicon_size"
            tools:src="@drawable/ic_launcher_white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="start|center_vertical"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <fr.neamar.kiss.ui.AutoMarqueeTextView
            android:id="@+id/item_app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="2dp"
            android:paddingBottom="3dp"
            android:shadowColor="?attr/resultShadowColor"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="?attr/textShadowRadius"
            android:textColor="?attr/resultColor"
            android:textDirection="locale"
            android:textIsSelectable="false"
            android:textSize="?attr/resultTitleSize"
            tools:textSize="@dimen/result_title_size"
            tools:ignore="RtlSymmetry,UnusedAttribute"
            tools:text="@string/stub_application" />

        <fr.neamar.kiss.ui.AutoMarqueeTextView
            android:id="@+id/item_shortcut_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="2dp"
            android:shadowColor="?attr/resultShadowColor"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="?attr/textShadowRadius"
            android:textColor="?android:attr/textColorSecondary"
            android:textDirection="locale"
            android:textIsSelectable="false"
            android:textSize="?attr/resultSubtitleSize"
            tools:textSize="@dimen/result_subtitle_size"
            tools:ignore="RtlSymmetry,UnusedAttribute"
            tools:text="@string/stub_app_tag" />

        <LinearLayout
            android:id="@+id/item_notification_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <fr.neamar.kiss.ui.AutoMarqueeTextView
                android:id="@+id/item_notification_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:shadowColor="?attr/resultShadowColor"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="?attr/textShadowRadius"
                android:textColor="?attr/resultColor"
                android:textSize="?attr/resultSubtitleSize" />

            <Button
                android:id="@+id/item_notification_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Mark read"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
