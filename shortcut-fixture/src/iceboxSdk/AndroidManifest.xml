<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="com.catchingnow.icebox.SDK" android:protectionLevel="dangerous" />
    <!-- The real Ice Box declares package visibility; the fixture must see its target too. -->
    <queries>
        <package android:name="com.tbzmike.shortcutfixture.target" />
    </queries>
    <application>
        <activity android:name="com.catchingnow.icebox.activity.ShortcutActionActivity"
            android:exported="true" android:launchMode="singleInstance" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="icebox" android:host="action" />
            </intent-filter>
        </activity>
        <provider android:name=".FixtureIceBoxProvider" android:exported="true"
            android:authorities="com.catchingnow.icebox.SDK"
            android:permission="com.catchingnow.icebox.SDK" />
    </application>
</manifest>
