<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="${fixtureLabel}" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".FixtureMainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".FixtureTargetActivity" android:exported="true" />
        <activity android:name=".FixturePrivateTargetActivity" android:exported="false" />
        <receiver android:name=".FixtureControlReceiver" android:exported="true" />
    </application>
</manifest>
